{
  "name": "home-base-app",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check:update": "node scripts/check-update-ready.mjs",
    "setup:hooks": "git config core.hooksPath .githooks",
    "build:backend-client": "node scripts/build-backend-client.mjs",
    "test": "node --test scripts/*.test.mjs tests/*.test.mjs",
    "test:backend": "node --test tests/backend*.test.mjs",
    "build:dispatch-function": "node scripts/build-dispatch-function.mjs",
    "test:release": "node --test tests/release-integrity.test.mjs tests/global-heat.test.mjs && node scripts/check-index-syntax.mjs && node --check dist/sw.js",
    "build:school-function": "node scripts/build-school-function.mjs",
    "history:manifest": "node -e \"const r=require('./tests/fixtures/load-history.cjs')(),o=r.reduce((n,x)=>n+(x.area_observations||[]).length,0),old=require('./tests/fixtures/demand-history-manifest.json'),ids=[...new Set([...old.ids,...r.map(x=>x.id)])].sort();require('fs').writeFileSync('tests/fixtures/demand-history-manifest.json',JSON.stringify({note:old.note,minimumObservations:Math.max(o,old.minimumObservations),ids}))\""
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "esbuild": "0.28.2"
  }
}
